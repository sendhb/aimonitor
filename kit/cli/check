#!/usr/bin/env bash
# ============================================================
# check — AIOS Framework 环境健康检查
# ============================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# 兼容 kit/ 子目录布局：向上找到含 aios.config.yaml 的项目根
while [ ! -f "$ROOT/aios.config.yaml" ] && [ "$ROOT" != "/" ]; do
  ROOT="$(dirname "$ROOT")"
done
GREEN='\033[0;32m'; RED='\033[0;31m'; YELLOW='\033[1;33m'; NC='\033[0m'
ok()  { echo -e "${GREEN}✓${NC} $1"; }
warn(){ echo -e "${YELLOW}⚠${NC} $1"; }
err() { echo -e "${RED}✗${NC} $1"; errors=$((errors+1)); }

echo -e "${YELLOW}══════ AIOS Framework 健康检查 ══════${NC}"
errors=0

# 兼容两种布局：
#   - 平铺：<root>/aios/ ...（框架目录在项目根）
#   - kit 子目录：<root>/kit/aios/ ...（框架目录在 kit/ 下）
if [ -d "$ROOT/kit" ]; then
  FRAME="$ROOT/kit"
  echo -e "${YELLOW}  布局: kit/ 子目录（框架根 = $FRAME）${NC}"
else
  FRAME="$ROOT"
fi

# 1. 核心目录
for d in aios/governance aios/execution aios/cognition aios/context aios/memory agents; do
  [ -d "$FRAME/$d" ] && ok "$d" || err "$d 缺失"
done

# 2. 核心文件
for f in AGENTS.md aios/governance/task-policy.md aios/governance/security-policy.md aios/execution/engine.md; do
  if [ -f "$FRAME/$f" ]; then
    ok "$f"
  else
    [ -f "$ROOT/$f" ] && ok "$f (项目根)" || err "$f 缺失"
  fi
done

# 3. Agent 角色
for r in manager analyst architect coder reviewer tester researcher; do
  [ -f "$FRAME/agents/$r/role.md" ] && ok "agents/$r" || warn "agents/$r 缺失"
done

# 4. 运行时目录（始终在项目根）
for d in runtime/tasks runtime/states runtime/reviews runtime/verification; do
  [ -d "$ROOT/$d" ] && ok "$d" || warn "$d 缺失"
done

# 5. CLI 可执行
for c in cli/task cli/init cli/check; do
  [ -x "$FRAME/$c" ] && ok "$c (可执行)" || warn "$c 不可执行"
done

# 5b. 新增入口（工具配置按项目根读取，检查 ROOT 而非 FRAME）
[ -d "$ROOT/.pi" ] && ok ".pi/" || warn ".pi/ 缺失"
[ -d "$ROOT/.claude/rules" ] && ok ".claude/rules/" || warn ".claude/rules/ 缺失"
[ -d "$ROOT/.cursor/rules" ] && ok ".cursor/rules/" || warn ".cursor/rules/ 缺失"

# 6. 任务模板（kit 布局下在 kit/runtime/；平铺时在 ROOT/runtime/）
if [ -f "$FRAME/runtime/tasks/TASK.template.md" ]; then
  ok "runtime/tasks/TASK.template.md"
elif [ -f "$ROOT/runtime/tasks/TASK.template.md" ]; then
  ok "runtime/tasks/TASK.template.md (项目根)"
else
  err "任务模板缺失"
fi

# 7. 入口文件
[ -f "$ROOT/AGENTS.md" ] && ok "AGENTS.md" || warn "AGENTS.md 缺失"
if [ -L "$ROOT/CLAUDE.md" ]; then ok "CLAUDE.md (symlink→AGENTS.md)"; else warn "CLAUDE.md 不是 symlink"; fi

echo -e "${YELLOW}════════════════════════════════════${NC}"
if [ $errors -eq 0 ]; then
  echo -e "${GREEN}✓ 框架完整${NC}"
  exit 0
else
  echo -e "${RED}✗ $errors 个问题${NC}"
  exit 1
fi

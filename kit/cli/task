def cmd_validate(args):
    errors = 0
    ev_errors, ev_total = validate_events()
    errors += ev_errors
    if ev_total:
        if ev_errors:
            print(f"✗ 事件文件共 {ev_total} 条，发现 {ev_errors} 个问题")
        else:
            print(f"✓ 事件文件共 {ev_total} 条，格式与 seq 校验通过")
    files = task_files()
    if not files:
        print("✓ runtime/tasks/ 为空，无需校验")
        print("✗ 校验失败，{} 个错误".format(errors) if errors else "✓ 校验完成，0 错误")
        sys.exit(1 if errors else 0)
    seen = set()
    for f in files:
        path = os.path.join(TASKS_DIR, f)
        text, fm = load_task(path)
        name = f[:-3]
        if fm is None:
            print(f"✗ {name}: frontmatter 缺失或损坏"); errors += 1; continue
        if fm.get("name") != name:
            print(f"✗ {name}: name 与文件名不一致（{fm.get('name')}）"); errors += 1
        for req in ["name", "description", "metadata.status", "metadata.created", "metadata.updated"]:
            if not fm.get(req):
                print(f"✗ {name}: 缺少必填字段 {req}"); errors += 1
        st = fm.get("metadata.status")
        if st not in STATUSES:
            print(f"✗ {name}: 非法状态 {st}"); errors += 1
        if st == "done":
            # 证据日期按任务完成当天（metadata.updated，状态机写入）判定，而非 validate 运行日
            ref_date = fm.get("metadata.updated") or today()
            if not verify_exists(name, ref_date):
                print(f"✗ {name}: done 任务缺少任务完成当天（{ref_date}）通过的 VERIFY 记录"); errors += 1
            risk = (fm.get("metadata.risk") or "P2").upper()
            priority = (fm.get("metadata.priority") or "P2").upper()
            reviewer = (fm.get("metadata.reviewer") or "any").strip()
            if risk == "P0" and (fm.get("metadata.approval-ref") or "none").strip().lower() in ("", "none", "n/a"):
                print(f"✗ {name}: P0 任务缺少 approval-ref"); errors += 1
            if risk in ("P0", "P1") or priority in ("P0", "P1") or reviewer not in ("", "any", "none"):
                if not review_exists(name, fm, ref_date):
                    print(f"✗ {name}: 缺少独立且通过的 REVIEW 记录"); errors += 1
            unchecked = [l for l in text.splitlines() if re.match(r"^\s*- \[ \]", l)]
            if unchecked:
                print(f"✗ {name}: done 任务仍有 {len(unchecked)} 条验收标准未勾选"); errors += 1
        if st == "in-review" and not review_exists(name):
            print(f"⚠ {name}: in-review 但暂无 REVIEW 记录（审查中属正常；approve 前必须写入）")
        num = TASK_RE.match(f)
        if num and num.group(1) in seen:
            print(f"✗ {name}: 编号重复"); errors += 1
        if num:
            seen.add(num.group(1))
    nums = sorted(int(TASK_RE.match(f).group(1)) for f in files if TASK_RE.match(f))
    if nums and nums != list(range(min(nums), max(nums) + 1)):
        missing = [n for n in range(min(nums), max(nums) + 1) if n not in nums]
        print(f"⚠ 编号不连续，缺失: {[f'TASK-{n:03d}' for n in missing]}")
    print("✓ 校验完成，0 错误" if errors == 0 else f"✗ 校验失败，{errors} 个错误")
    sys.exit(1 if errors else 0)


def cmd_index(args):
    files = task_files()
    if not os.path.isdir(TASKS_DIR):
        os.makedirs(TASKS_DIR)
    if not os.path.isdir(STATE_DIR):
        os.makedirs(STATE_DIR)
    rows = []
    for f in files:
        _, fm = load_task(os.path.join(TASKS_DIR, f))
        if fm is None:
            continue
        rows.append((f[:-3], fm.get("metadata.status", "?"),
                     fm.get("description", ""), fm.get("metadata.assignee", "any")))
    # INDEX.md
    idx = ["# INDEX — 任务索引（自动生成，勿手动编辑）", "", "| 任务 | 状态 | 描述 | assignee |", "|------|------|------|----------|"]
    for r in sorted(rows):
        desc = str(r[2]).split("\n")[0][:50]
        idx.append(f"| {r[0]} | {r[1]} | {desc} | {r[3]} |")
    with open(os.path.join(TASKS_DIR, "INDEX.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(idx) + "\n")
    # PROGRESS.md
    from collections import Counter
    cnt = Counter(r[1] for r in rows)
    prog = ["# Progress — 项目进度（自动生成，勿手动编辑）", "", "## 统计", "", "| 状态 | 数量 |", "|------|------|"]
    for s in STATUSES:
        prog.append(f"| {s} | {cnt.get(s, 0)} |")
    prog += ["", "## 进行中", "", "| 任务 | 状态 | 描述 | assignee |", "|------|------|------|----------|"]
    for r in sorted(r for r in rows if r[1] in ("in-progress", "in-review")):
        prog.append(f"| {r[0]} | {r[1]} | {str(r[2])[:50]} | {r[3]} |")
    prog += ["", "## 已完成（最近 10 条）", "", "| 任务 | 描述 |", "|------|------|"]
    done = sorted((r for r in rows if r[1] == "done"), reverse=True)[:10]
    for r in done:
        prog.append(f"| {r[0]} | {str(r[2])[:50]} |")
    with open(os.path.join(STATE_DIR, "PROGRESS.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(prog) + "\n")
    print(f"✓ 已生成 runtime/tasks/INDEX.md 与 runtime/states/PROGRESS.md（{len(rows)} 个任务）")


def cmd_stats(args):
    from collections import Counter
    cnt = Counter()
    for f in task_files():
        _, fm = load_task(os.path.join(TASKS_DIR, f))
        cnt[fm.get("metadata.status", "?") if fm else "?"] += 1
    for s in STATUSES + ["?"]:
        print(f"{s:<12} {cnt.get(s, 0)}")


def _read_jsonl(path):
    """读 jsonl 为 list[dict]；文件缺失/为空 → []；坏行 stderr 告警后跳过（TASK-093）。"""
    if not os.path.isfile(path):
        return []
    rows = []
    with open(path, encoding="utf-8") as f:
        for ln, line in enumerate(f, 1):
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except ValueError:
                print(f"⚠ {path}:{ln} 非合法 JSON，已跳过", file=sys.stderr)
    return rows


def cmd_metrics(args):
    """评估汇总（TASK-093）：done 率 / 平均 rework-count / token 估算合计。

    - done 率：runtime/tasks 全量实时口径（status=done / 全部任务）。
    - 平均 rework-count：优先 metrics/task-metrics.jsonl 采集数据（--days 按 done_at
      收窄）；无采集数据时回退实时 frontmatter（采集自 TASK-093 上线，历史任务过渡）。
    - token 估算合计：聚合 runtime/logs/token-usage.jsonl（--days 按 ts 收窄）；
      文件缺失/为空输出 N/A 不报错（退出码 0）。
    """
    days = None
    if "--days" in args:
        i = args.index("--days")
        if i + 1 >= len(args):
            die("--days 需要一个整数参数，如: task metrics --days 30")
        try:
            days = int(args[i + 1])
        except ValueError:
            die(f"--days 需要整数，得到: {args[i + 1]}")
        args = args[:i] + args[i + 2:]
    if args:
        die(f"未知参数: {' '.join(args)}")

    cutoff = None
    if days is not None:
        cutoff = (datetime.date.today() - datetime.timedelta(days=days)).isoformat()

    # done 率（实时全量）+ 回退用 rework 列表
    total = done_cnt = 0
    reworks = []
    for f in task_files():
        _, fm = load_task(os.path.join(TASKS_DIR, f))
        if not fm:
            continue
        total += 1
        if (fm.get("metadata.status") or "") == "done":
            done_cnt += 1
        try:
            reworks.append(int(str(fm.get("metadata.rework-count") or 0).strip() or 0))
        except ValueError:
            reworks.append(0)
    pct = (done_cnt * 100.0 / total) if total else 0.0
    print(f"done 率: {done_cnt}/{total} ({pct:.1f}%)")

    # 平均 rework-count（采集数据优先，空则回退实时）
    records = _read_jsonl(os.path.join(tasklib.evaluation_dir(AI_DIR),
                                       "metrics", "task-metrics.jsonl"))
    if cutoff is not None:
        records = [r for r in records if str(r.get("done_at") or "") >= cutoff]
    if records:
        vals = [r["rework-count"] for r in records
                if isinstance(r.get("rework-count"), (int, float))]
        avg = (sum(vals) / len(vals)) if vals else 0.0
        src = "metrics/task-metrics.jsonl"
    else:
        avg = (sum(reworks) / len(reworks)) if reworks else 0.0
        src = "runtime/tasks 实时回退（无采集数据）"
    print(f"平均 rework-count: {avg:.2f}（来源: {src}）")

    # token 估算合计
    usage = _read_jsonl(os.path.join(LOG_DIR, "token-usage.jsonl"))
    tokens = 0
    if usage:
        cutoff_ts = None
        if cutoff is not None:
            cutoff_ts = datetime.datetime.combine(
                datetime.date.fromisoformat(cutoff), datetime.time.min).timestamp()
        for r in usage:
            ts = r.get("ts")
            if cutoff_ts is not None and isinstance(ts, (int, float)) and ts < cutoff_ts:
                continue
            v = r.get("token_estimate")
            if isinstance(v, (int, float)):
                tokens += int(v)
        token_txt = str(tokens)
    else:
        token_txt = "N/A"
    window = f"（近 {days} 天）" if days is not None else ""
    print(f"token 估算合计: {token_txt}{window}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "-h", "--help"):
        print(USAGE)
        return
    cmd, rest = args[0], args[1:]
    cmds = {
        "new": cmd_new, "list": cmd_list, "show": cmd_show,
        "start": cmd_start, "verify": cmd_verify, "review": cmd_review, "approve": cmd_approve,
        "done": cmd_done, "block": cmd_block,
        "unblock": cmd_unblock, "cancel": cmd_cancel,
        "validate": cmd_validate, "index": cmd_index, "stats": cmd_stats,
        "metrics": cmd_metrics, "stale": cmd_stale,
    }
    fn = cmds.get(cmd)
    if not fn:
        die(f"未知命令: {cmd}\n运行 task help 查看用法")
    fn(rest)


if __name__ == "__main__":
    main()

def bump_rework(path, task_id):
    """in-review → in-progress（打回）时递增 metadata.rework-count；超限拒绝。

    首次开始（open → in-progress）不计数。返回新值；未打回时返回 None。
    """
    _, fm = load_task(path)
    if (fm or {}).get("metadata.status") != "in-review":
        return None
    rework = 0
    raw = (fm.get("metadata.rework-count") or "0").strip()
    try:
        rework = int(raw)
    except ValueError:
        rework = 0
    new_rework = rework + 1
    if new_rework > REWORK_LIMIT:
        die(f"{task_id}: 返工已达上限（{REWORK_LIMIT} 次，第 {new_rework} 次打回被拒绝）。"
            f"请人工介入：拆分任务，或记录介入原因后调整 metadata.rework-count 继续。")
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    if re.search(r"^\s*rework-count:\s*", text, re.M):
        text = re.sub(r"^(\s*rework-count:\s*).*$", r"\g<1>" + str(new_rework), text, count=1, flags=re.M)
    else:
        # 旧任务无该字段：在 depends-on 后插入
        text = re.sub(r"^(\s*depends-on:.*)$", r"\1\n  rework-count: " + str(new_rework), text, count=1, flags=re.M)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    print(f"✓ 打回计数 rework-count: {rework} → {new_rework}")
    return new_rework


def cmd_start(args):
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    bump_rework(path, args[0])
    set_status(path, "in-progress")
    touch_focus(args[0])


def _git_commit():
    try:
        proc = subprocess.run(["git", "rev-parse", "--short", "HEAD"],
                               cwd=AI_DIR, capture_output=True, text=True,
                               encoding="utf-8", errors="replace")
        out = proc.stdout.strip()
        return out if proc.returncode == 0 and out else "n/a"
    except FileNotFoundError:
        return "n/a"


def cmd_verify(args):
    """真正执行 config.commands.build/lint/test/check（不是查文件形状），全部通过才写 VERIFY 记录。"""
    if not args:
        die("用法: task verify TASK-xxx")
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    _, fm = load_task(path)
    task_id = short_id(fm.get("name") if fm else None) or short_id(args[0]) or args[0]

    try:
        cfg = cfg_lib.load_config(AI_DIR)
    except cfg_lib.ConfigError as e:
        die(str(e))

    steps = ["build", "lint", "test", "check"]
    transcript = [f"# Verify — {task_id} — {datetime.datetime.now().isoformat()}", ""]
    for step in steps:
        cmd = cfg["commands"][step]
        print(f"▶ {step}: {cmd}")
        transcript.append(f"$ {cmd}   # {step}")
        proc = subprocess.run(cmd, shell=True, cwd=AI_DIR, capture_output=True, text=True,
                              encoding="utf-8", errors="replace")
        transcript.append(proc.stdout)
        transcript.append(proc.stderr)
        if proc.returncode != 0:
            transcript.append(f"✗ {step} 失败（exit {proc.returncode}）")
            os.makedirs(LOG_DIR, exist_ok=True)
            fail_log = os.path.join(LOG_DIR, f"fail-{today()}.log")
            with open(fail_log, "a", encoding="utf-8") as f:
                f.write("\n".join(transcript) + "\n\n")
            die(f"{step} 未通过，详情见 {os.path.relpath(fail_log, AI_DIR)}")

    commit = _git_commit()
    verify_name = f"VERIFY-{today()}-{task_id.lower()}"
    rows = "\n".join(f"| {s} | `{cfg['commands'][s]}` | ✅ |" for s in steps)
    body = (
        "---\n"
        f"name: {verify_name}\n"
        f"description: 自动验证 {task_id}（build/lint/test/check 全部通过，非自证）\n"
        "metadata:\n"
        "  type: verify\n"
        f"  date: {today()}\n"
        f"  task-ref: {task_id}\n"
        "  verifier: cli/task-verify\n"
        "  result: pass\n"
        f"  commit: {commit}\n"
        "---\n\n"
        f"# VERIFY — {task_id}\n\n"
        "由 `task verify` 自动生成：实际执行了下列命令并全部通过。\n\n"
        "## 命令与结果\n\n"
        "| 步骤 | 命令 | 结果 |\n|------|------|------|\n" + rows + "\n"
    )
    os.makedirs(VERIFY_DIR, exist_ok=True)
    out_path = os.path.join(VERIFY_DIR, verify_name + ".md")
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(body)
    print(f"✓ 全部通过，已写 {os.path.relpath(out_path, AI_DIR)}")


def cmd_done(args):
    if "--force" in args:
        die("--force 不能绕过任务关闭前置条件；请记录人工批准并满足证据要求")
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    set_status(path, "done", force=False)
    cmd_index([])
    print("提示: 更新 runtime/states/CURRENT_FOCUS.md 切换到下一个任务")


def cmd_block(args):
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    reason = args[1] if len(args) > 1 else "（未填原因）"
    set_status(path, "blocked")
    append_blocker(args[0], reason)
    print("提示: 更新 runtime/states/CURRENT_FOCUS.md")


def cmd_unblock(args):
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    set_status(path, "in-progress")


def cmd_review(args):
    """提交审查：in-progress → in-review（实现完成，等待生成者之外的审查者）"""
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    set_status(path, "in-review")
    touch_focus(args[0])
    print("提示: 审查通过后 task approve TASK-xxx 关闭；需返工则 task start TASK-xxx（回 in-progress）")


def cmd_approve(args):
    """审查通过并关闭：in-review → done（强制要求 REVIEW 记录）"""
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    set_status(path, "done", require_review=True)
    cmd_index([])
    print("提示: 更新 runtime/states/CURRENT_FOCUS.md 切换到下一个任务")


def cmd_cancel(args):
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    set_status(path, "cancelled")


def touch_focus(task_id):
    path = os.path.join(STATE_DIR, "CURRENT_FOCUS.md")
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"---\nname: CURRENT_FOCUS\nmetadata:\n  type: state\n  updated: {today()}\n---\n\n"
                    f"# Current Focus — {today()}\n\n"
                    f"## 当前任务\n{task_id} — in-progress\n\n"
                    f"## 下一个动作\n1. 按 SDD_WORKFLOW.md 执行 {task_id}\n")
        print(f"✓ 已创建 runtime/states/CURRENT_FOCUS.md")
        return
    with open(path, encoding="utf-8") as f:
        text = f.read()
    text = re.sub(r"(updated:\s*)\d{4}-\d{2}-\d{2}", r"\g<1>" + today(), text, count=1)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def append_blocker(task_id, reason):
    path = os.path.join(STATE_DIR, "BLOCKERS.md")
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"---\nname: BLOCKERS\nmetadata:\n  type: state\n  updated: {today()}\n---\n\n# Blockers\n")
    with open(path, encoding="utf-8") as f:
        text = f.read()
    num = len(re.findall(r"^### BLOCKER-\d+", text, re.M)) + 1
    entry = f"\n### BLOCKER-{num:03d} — {reason[:60]}\n\n" \
            f"| 项 | 内容 |\n|----|------|\n" \
            f"| 阻塞任务 | {task_id} |\n" \
            f"| 记录日期 | {today()} |\n" \
            f"| 状态 | open |\n"
    with open(path, "w", encoding="utf-8") as f:
        f.write(text.rstrip() + "\n" + entry)
    print(f"✓ 已追加 BLOCKER-{num:03d} 到 runtime/states/BLOCKERS.md")


# ---------------- 校验 / 索引 ----------------

def cmd_validate(args):
    files = task_files()
    if not files:
        print("✓ runtime/tasks/ 为空，无需校验")
        return
    errors, seen = 0, set()
    for f in files:
        path = os.path.join(TASKS_DIR, f)
        text, fm = load_task(path)
        name = f[:-3]
        if fm is None:
            print(f"✗ {name}: frontmatter 缺失或损坏"); errors += 1; continue
        if fm.get("name") != name:
            print(f"✗ {name}: name 与文件名不一致（{fm.get('name')}）"); errors += 1
        for req in ["name", "description", "metadata.status", "metadata.created", "metadata.updated"]:
            if not fm.get(req):
                print(f"✗ {name}: 缺少必填字段 {req}"); errors += 1
        st = fm.get("metadata.status")
        if st not in STATUSES:
            print(f"✗ {name}: 非法状态 {st}"); errors += 1
        if st == "done":
            # 证据日期按任务完成当天（metadata.updated，状态机写入）判定，而非 validate 运行日
            ref_date = fm.get("metadata.updated") or today()
            if not verify_exists(name, ref_date):
                print(f"✗ {name}: done 任务缺少任务完成当天（{ref_date}）通过的 VERIFY 记录"); errors += 1
            risk = (fm.get("metadata.risk") or "P2").upper()
            priority = (fm.get("metadata.priority") or "P2").upper()
            reviewer = (fm.get("metadata.reviewer") or "any").strip()
            if risk == "P0" and (fm.get("metadata.approval-ref") or "none").strip().lower() in ("", "none", "n/a"):
                print(f"✗ {name}: P0 任务缺少 approval-ref"); errors += 1
            if risk in ("P0", "P1") or priority in ("P0", "P1") or reviewer not in ("", "any", "none"):
                if not review_exists(name, fm, ref_date):
                    print(f"✗ {name}: 缺少独立且通过的 REVIEW 记录"); errors += 1
            unchecked = [l for l in text.splitlines() if re.match(r"^\s*- \[ \]", l)]
            if unchecked:
                print(f"✗ {name}: done 任务仍有 {len(unchecked)} 条验收标准未勾选"); errors += 1
        if st == "in-review" and not review_exists(name):
            print(f"⚠ {name}: in-review 但暂无 REVIEW 记录（审查中属正常；approve 前必须写入）")
        num = TASK_RE.match(f)
        if num and num.group(1) in seen:
            print(f"✗ {name}: 编号重复"); errors += 1
        if num:
            seen.add(num.group(1))
    nums = sorted(int(TASK_RE.match(f).group(1)) for f in files if TASK_RE.match(f))
    if nums and nums != list(range(min(nums), max(nums) + 1)):
        missing = [n for n in range(min(nums), max(nums) + 1) if n not in nums]
        print(f"⚠ 编号不连续，缺失: {[f'TASK-{n:03d}' for n in missing]}")
    print("✓ 校验完成，0 错误" if errors == 0 else f"✗ 校验失败，{errors} 个错误")
    sys.exit(1 if errors else 0)


def cmd_index(args):
    files = task_files()
    if not os.path.isdir(TASKS_DIR):
        os.makedirs(TASKS_DIR)
    if not os.path.isdir(STATE_DIR):
        os.makedirs(STATE_DIR)
    rows = []
    for f in files:
        _, fm = load_task(os.path.join(TASKS_DIR, f))
        if fm is None:
            continue
        rows.append((f[:-3], fm.get("metadata.status", "?"),
                     fm.get("description", ""), fm.get("metadata.assignee", "any")))
    # INDEX.md
    idx = ["# INDEX — 任务索引（自动生成，勿手动编辑）", "", "| 任务 | 状态 | 描述 | assignee |", "|------|------|------|----------|"]
    for r in sorted(rows):
        desc = str(r[2]).split("\n")[0][:50]
        idx.append(f"| {r[0]} | {r[1]} | {desc} | {r[3]} |")
    with open(os.path.join(TASKS_DIR, "INDEX.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(idx) + "\n")
    # PROGRESS.md
    from collections import Counter
    cnt = Counter(r[1] for r in rows)
    prog = ["# Progress — 项目进度（自动生成，勿手动编辑）", "", "## 统计", "", "| 状态 | 数量 |", "|------|------|"]
    for s in STATUSES:
        prog.append(f"| {s} | {cnt.get(s, 0)} |")
    prog += ["", "## 进行中", "", "| 任务 | 状态 | 描述 | assignee |", "|------|------|------|----------|"]
    for r in sorted(r for r in rows if r[1] in ("in-progress", "in-review")):
        prog.append(f"| {r[0]} | {r[1]} | {str(r[2])[:50]} | {r[3]} |")
    prog += ["", "## 已完成（最近 10 条）", "", "| 任务 | 描述 |", "|------|------|"]
    done = sorted((r for r in rows if r[1] == "done"), reverse=True)[:10]
    for r in done:
        prog.append(f"| {r[0]} | {str(r[2])[:50]} |")
    with open(os.path.join(STATE_DIR, "PROGRESS.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(prog) + "\n")
    print(f"✓ 已生成 runtime/tasks/INDEX.md 与 runtime/states/PROGRESS.md（{len(rows)} 个任务）")


def cmd_stats(args):
    from collections import Counter
    cnt = Counter()
    for f in task_files():
        _, fm = load_task(os.path.join(TASKS_DIR, f))
        cnt[fm.get("metadata.status", "?") if fm else "?"] += 1
    for s in STATUSES + ["?"]:
        print(f"{s:<12} {cnt.get(s, 0)}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("help", "-h", "--help"):
        print(USAGE)
        return
    cmd, rest = args[0], args[1:]
    cmds = {
        "new": cmd_new, "list": cmd_list, "show": cmd_show,
        "start": cmd_start, "verify": cmd_verify, "review": cmd_review, "approve": cmd_approve,
        "done": cmd_done, "block": cmd_block,
        "unblock": cmd_unblock, "cancel": cmd_cancel,
        "validate": cmd_validate, "index": cmd_index, "stats": cmd_stats,
    }
    fn = cmds.get(cmd)
    if not fn:
        die(f"未知命令: {cmd}\n运行 task help 查看用法")
    fn(rest)


if __name__ == "__main__":
    main()

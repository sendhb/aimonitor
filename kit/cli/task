# ---------------- reviewer 存活守卫 / 唤醒 / 滞留检测（TASK-107） ----------------

REVIEWER_HEARTBEAT = "autoloop-reviewer.heartbeat"  # 与 autoloop_reviewer.NAME 对应


def _heartbeat_age(path, now):
    """心跳文件 mtime 距 now 秒数；缺失 → None（与 autoloop_launcher.heartbeat_age 同式）。"""
    try:
        return now - os.path.getmtime(path)
    except OSError:
        return None


def _hb_max_age():
    """reviewer 心跳阈值（秒）：默认 2×30+1800=1860（与 autoloop ensure 默认同式），
    env AUTOLOOP_HEARTBEAT_MAX_AGE 可覆盖。常驻 reviewer 一轮内 LLM 会话最长
    timeout(1800s) + 间隔，冗余一倍；超过即判不在岗。"""
    try:
        v = int(os.environ.get("AUTOLOOP_HEARTBEAT_MAX_AGE", ""))
        if v > 0:
            return v
    except ValueError:
        pass
    return 2 * 30 + 1800


def _reviewer_heartbeat_age(log_dir, now=None):
    return _heartbeat_age(os.path.join(log_dir, REVIEWER_HEARTBEAT),
                          time.time() if now is None else now)


def _reviewer_alive_guard(log_dir, now=None):
    """reviewer 心跳守卫：不在岗（心跳停滞/从未运行）→ 醒目告警 + 自愈指引。

    返回是否告警。in-review 转换点的机械检查：reviewer 已死时请求就是发给空气，
    任务将静默滞留——告警不阻断（人工流程照常可用）。
    """
    age = _reviewer_heartbeat_age(log_dir, now)
    if age is not None and age <= _hb_max_age():
        return False
    max_age = _hb_max_age()
    why = "从未运行（无心跳）" if age is None else "心跳 %d 秒前（超阈值 %d 秒）" % (int(age), max_age)
    print("⚠⚠ reviewer 不在岗：%s —— in-review 任务将无人认领（静默滞留）" % why)
    print("   处置: python kit/cli/autoloop ensure   # 幂等探活+拉起（看门狗，可挂定时器）")
    return True


def _wake_reviewer(root, log_dir):
    """reviewer 不在岗时后台拉起一次单轮审查（--once）；在岗则跳过。

    复用 autoloop_coder 的 Popen 分离语义（DETACHED/start_new_session）；
    reviewer 内层锁（autoloop-reviewer.lock）防重入：已在跑的实例不受影响，
    重复 wake 的子进程拿不到锁自然退出。返回 0=已拉起/在岗，1=拉起失败。
    """
    age = _reviewer_heartbeat_age(log_dir)
    if age is not None and age <= _hb_max_age():
        print("· reviewer 心跳正常（%d 秒前），无需唤醒" % int(age))
        return 0
    script = os.path.join(root, "kit", "cli", "lib", "autoloop_reviewer.py")
    if not os.path.isfile(script):
        print("⚠ 找不到 reviewer 核心: %s，无法唤醒（可运行 python kit/cli/autoloop ensure 拉起完整循环）" % script)
        return 1
    kwargs = {}
    if os.name == "nt":
        kwargs["creationflags"] = (subprocess.CREATE_NEW_PROCESS_GROUP
                                   | subprocess.DETACHED_PROCESS)
    else:
        kwargs["start_new_session"] = True
    try:
        subprocess.Popen([sys.executable, script, "--once"], cwd=root,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, **kwargs)
    except OSError as e:
        print("⚠ reviewer 唤醒失败: %s（可运行 python kit/cli/autoloop ensure）" % e)
        return 1
    print("✓ 已后台拉起 reviewer 单轮（--once）；日志: runtime/logs/autoloop-reviewer-%s.log"
          % tasklib.today())
    return 0


def _stale_hours(updated, now):
    """metadata.updated（日期粒度）→ 滞留小时数（自当日 00:00 起算，宁早勿晚）；
    不可解析/未来日期 → 0 或 None（纯函数，单测锚点）。"""
    try:
        base = datetime.datetime.strptime(str(updated).strip(), "%Y-%m-%d")
    except ValueError:
        return None
    return max(0.0, (now - base.timestamp()) / 3600.0)


def cmd_stale(args):
    """滞留检测（TASK-107）：in-review 任务按 metadata.updated 计滞留时长。

    超阈值（默认 2 小时，--hours N 可调）逐条 `⚠ 滞留 N 小时`；全部健康
    exit 0，有滞留 exit 2（供监控/CI 消费）。updated 为日期粒度：同日转
    review 的任务自当日 00:00 起算（宁可早报，不重演多天静默滞留）。
    """
    hours = 2.0
    if "--hours" in args:
        i = args.index("--hours")
        if i + 1 >= len(args):
            die("--hours 需要一个数字参数，如: task stale --hours 4")
        try:
            hours = float(args[i + 1])
        except ValueError:
            die(f"--hours 需要数字，得到: {args[i + 1]}")
        args = args[:i] + args[i + 2:]
    if args:
        die(f"未知参数: {' '.join(args)}")
    now = time.time()
    stale = []
    for f in task_files():
        _, fm = load_task(os.path.join(TASKS_DIR, f))
        if not fm or fm.get("metadata.status") != "in-review":
            continue
        age_h = _stale_hours(fm.get("metadata.updated"), now)
        if age_h is not None and age_h > hours:
            stale.append((f[:-3], age_h))
    if not stale:
        print(f"✓ 无滞留 in-review 任务（阈值 {hours:g} 小时）")
        return
    for name, h in sorted(stale):
        print(f"⚠ {name} 滞留 {h:.1f} 小时")
    print(f"✗ {len(stale)} 个 in-review 任务滞留（阈值 {hours:g} 小时）——"
          f"处置: python kit/cli/autoloop ensure 拉起 reviewer，或人工 task approve / task start")
    sys.exit(2)


def cmd_review(args):
    """提交审查：in-progress → in-review（实现完成，等待生成者之外的审查者）

    TASK-107 增补：--wake（reviewer 不在岗时后台拉起一次单轮审查）；
    reviewer 心跳守卫告警；末尾刷新 INDEX/PROGRESS（对齐 cmd_approve，
    治索引与 frontmatter 漂移）。
    """
    wake = "--wake" in args
    args = [a for a in args if a != "--wake"]
    if not args:
        die("task review 需要 <task-id> [--wake]")
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    # TASK-101 硬拦截：reviewer 未指定（any/空/none）的任务转 in-review 后，机械层
    # 判 fast-path，reviewer 循环会静默跳过（TASK-099/100 两次实录）。判定复用
    # tasklib.is_fast_path 同一函数（单一事实源，不写第二套），在事故发生的转换点
    # 使不一致状态无法被创造。die 先于任何状态变更/事件写入。
    _, fm = load_task(path)
    if fm is None:
        die(f"frontmatter 缺失或损坏: {path}")
    if tasklib.is_fast_path(fm):
        reviewer = (fm.get("metadata.reviewer") or "any").strip() or "any"
        die(f"{short_id(os.path.basename(path))} front-matter reviewer={reviewer}，转 in-review 后将被机械判为\n"
            f"  fast-path，reviewer 循环会静默跳过（TASK-099/100 两次实录）。\n"
            f"  二选一：\n"
            f"  ① 编辑 front-matter 指定 reviewer（完整路径，由独立会话审查）\n"
            f"  ② 走 fast-path：确认 VERIFY 记录存在后直接 task done")
    set_status(path, "in-review", ev="task.review_requested")
    touch_focus(args[0])
    _reviewer_alive_guard(LOG_DIR)  # TASK-107：reviewer 不在岗 → 醒目告警
    if wake:
        _wake_reviewer(AI_DIR, LOG_DIR)
    cmd_index([])  # TASK-107：对齐 cmd_approve，治 INDEX/PROGRESS 漂移
    print("提示: 审查通过后 task approve TASK-xxx 关闭；需返工则 task start TASK-xxx（回 in-progress）")


def cmd_approve(args):
    """审查通过并关闭：in-review → done（强制要求 REVIEW 记录）"""
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    set_status(path, "done", require_review=True, ev="task.approved")
    cmd_index([])
    print("提示: 更新 runtime/states/CURRENT_FOCUS.md 切换到下一个任务")


def cmd_cancel(args):
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    set_status(path, "cancelled", ev="task.cancelled")


def touch_focus(task_id):
    path = os.path.join(STATE_DIR, "CURRENT_FOCUS.md")
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"---\nname: CURRENT_FOCUS\nmetadata:\n  type: state\n  updated: {today()}\n---\n\n"
                    f"# Current Focus — {today()}\n\n"
                    f"## 当前任务\n{task_id} — in-progress\n\n"
                    f"## 下一个动作\n1. 按 SDD_WORKFLOW.md 执行 {task_id}\n")
        print(f"✓ 已创建 runtime/states/CURRENT_FOCUS.md")
        return
    with open(path, encoding="utf-8") as f:
        text = f.read()
    text = re.sub(r"(updated:\s*)\d{4}-\d{2}-\d{2}", r"\g<1>" + today(), text, count=1)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


def append_blocker(task_id, reason):
    path = os.path.join(STATE_DIR, "BLOCKERS.md")
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write(f"---\nname: BLOCKERS\nmetadata:\n  type: state\n  updated: {today()}\n---\n\n# Blockers\n")
    with open(path, encoding="utf-8") as f:
        text = f.read()
    num = len(re.findall(r"^### BLOCKER-\d+", text, re.M)) + 1
    entry = f"\n### BLOCKER-{num:03d} — {reason[:60]}\n\n" \
            f"| 项 | 内容 |\n|----|------|\n" \
            f"| 阻塞任务 | {task_id} |\n" \
            f"| 记录日期 | {today()} |\n" \
            f"| 状态 | open |\n"
    with open(path, "w", encoding="utf-8") as f:
        f.write(text.rstrip() + "\n" + entry)
    print(f"✓ 已追加 BLOCKER-{num:03d} 到 runtime/states/BLOCKERS.md")



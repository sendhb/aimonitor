def _write_status(status_path, **fields):
    """写 verify 状态文件（TASK-088）：JSON 原子替换，读方不会看到半截内容。

    人类/监控端以 mtime 判活（与 autoloop heartbeat 同构，events.py）。"""
    os.makedirs(os.path.dirname(status_path), exist_ok=True)
    payload = dict(fields)
    payload["updated_at"] = datetime.datetime.now().isoformat()
    tmp = status_path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2)
    os.replace(tmp, status_path)
    return status_path


def _run_step_streamed(cmd, cwd, step, status_path, hb_interval=30.0, extra=None):
    """流式执行一条 verify 命令（TASK-088，替代 capture_output 静默长跑）。

    - 输出逐行实时转发到终端：UE 等长构建不再是黑屏，人类直接看构建日志判进度；
    - 执行期间周期写 status_path（step/pid/elapsed_s/updated_at），mtime 判活；
    - 返回 (returncode, 合并输出)，transcript 语义与旧 capture_output 一致。
    """
    proc = subprocess.Popen(cmd, shell=True, cwd=cwd,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, encoding="utf-8", errors="replace")
    stop = threading.Event()
    started = time.monotonic()

    def _beat():
        while not stop.wait(hb_interval):
            _write_status(status_path, step=step, pid=proc.pid,
                          elapsed_s=int(time.monotonic() - started), **(extra or {}))

    _write_status(status_path, step=step, pid=proc.pid, elapsed_s=0, **(extra or {}))
    hb = threading.Thread(target=_beat, daemon=True)
    hb.start()
    lines = []
    for line in proc.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        lines.append(line)
    proc.stdout.close()  # Popen 不自动关管道读端；autoloop 长跑反复执行，防 fd 泄漏
    rc = proc.wait()
    stop.set()
    hb.join()
    _write_status(status_path, step=step, pid=proc.pid,
                  elapsed_s=int(time.monotonic() - started),
                  returncode=rc, **(extra or {}))
    return rc, "".join(lines)


def cmd_verify(args):
    """真正执行 config.commands.build/lint/test/check（不是查文件形状），全部通过才写 VERIFY 记录。"""
    if not args:
        die("用法: task verify TASK-xxx")
    path = find_task(args[0])
    if not path:
        die(f"未找到任务: {args[0]}")
    _, fm = load_task(path)
    task_id = short_id(fm.get("name") if fm else None) or short_id(args[0]) or args[0]
    cur = (fm or {}).get("metadata.status")

    try:
        cfg = cfg_lib.load_config(AI_DIR)
    except cfg_lib.ConfigError as e:
        die(str(e))

    steps = ["build", "lint", "test", "check"]
    status_path = os.path.join(LOG_DIR, "verify-status.json")
    transcript = [f"# Verify — {task_id} — {datetime.datetime.now().isoformat()}", ""]
    for step in steps:
        cmd = cfg["commands"][step]
        print(f"▶ {step}: {cmd}")
        transcript.append(f"$ {cmd}   # {step}")
        rc, out = _run_step_streamed(cmd, cwd=AI_DIR, step=step,
                                     status_path=status_path, extra={"task": task_id})
        transcript.append(out)
        if rc != 0:
            transcript.append(f"✗ {step} 失败（exit {rc}）")
            os.makedirs(LOG_DIR, exist_ok=True)
            fail_log = os.path.join(LOG_DIR, f"fail-{today()}.log")
            with open(fail_log, "a", encoding="utf-8") as f:
                f.write("\n".join(transcript) + "\n\n")
            tail_log = os.path.join(LOG_DIR, f"fail-{today()}.tail")
            tail_lines = "\n".join(transcript).splitlines()[-100:]
            with open(tail_log, "w", encoding="utf-8") as f:
                f.write("\n".join(tail_lines) + "\n")
            fail_log_rel = os.path.relpath(fail_log, AI_DIR)
            # 评估自动采集（TASK-093）：失败即落盘 failures.jsonl，旁路不阻塞 die
            try:
                tasklib.collect_verify_failure(AI_DIR, task_id, cmd, fail_log_rel)
            except Exception as e:  # noqa: BLE001 —— 旁路采集不得影响失败报告
                print(f"⚠ 评估采集异常（主流程不受影响）: {e}", file=sys.stderr)
            die(
                f"{step} 未通过，详情见 {fail_log_rel}；"
                f"尾部见 {os.path.relpath(tail_log, AI_DIR)}"
            )

    commit = _git_commit()
    verify_name = f"VERIFY-{today()}-{task_id.lower()}"
    rows = "\n".join(f"| {s} | `{cfg['commands'][s]}` | ✅ |" for s in steps)
    body = (
        "---\n"
        f"name: {verify_name}\n"
        f"description: 自动验证 {task_id}（build/lint/test/check 全部通过，非自证）\n"
        "metadata:\n"
        "  type: verify\n"
        f"  date: {today()}\n"
        f"  task-ref: {task_id}\n"
        "  verifier: cli/task-verify\n"
        "  result: pass\n"
        f"  commit: {commit}\n"
        "---\n\n"
        f"# VERIFY — {task_id}\n\n"
        "由 `task verify` 自动生成：实际执行了下列命令并全部通过。\n\n"
        "## 命令与结果\n\n"
        "| 步骤 | 命令 | 结果 |\n|------|------|------|\n" + rows + "\n"
    )
    os.makedirs(VERIFY_DIR, exist_ok=True)
    out_path = os.path.join(VERIFY_DIR, verify_name + ".md")
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(body)
    print(f"✓ 全部通过，已写 {os.path.relpath(out_path, AI_DIR)}")
    append_event("task.verified", task_id, from_status=cur, to_status=cur)



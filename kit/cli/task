# ---- 跨进程事件锁（TASK-099）：并发 task new 的 seq/编号竞争修复 ----
# 实录：2026-09-04 并行两条 task new 各写 task-events.jsonl seq=174；
# 任务编号同理可能撞号。锁把「读序号 → 写文件」变成临界区。
EVENTS_LOCK = os.path.join(RUNTIME_DIR, "locks", "task-events.lock")
_events_lock_held = False  # 进程内重入标记（CLI 主线程串行；跨进程/跨线程由 flock 互斥）


@contextlib.contextmanager
def _events_lock(timeout=10.0):
    """task-events.jsonl 追加 / 任务编号分配 的跨进程互斥（TASK-099）。

    复用 lock.py 的跨平台原语（POSIX: fcntl.flock；Windows: msvcrt.locking）。
    阻塞轮询至多 timeout 秒；超时降级放行并告警 —— 与事件追加「失败只告警
    不阻断」语义一致：宁可低概率偶发竞争，不卡死任务操作。
    同进程重入直接放行（外层已持锁；flock 对同线程新开 fd 仍互斥，会假死锁）。
    """
    global _events_lock_held
    if _events_lock_held:
        yield
        return
    os.makedirs(os.path.dirname(EVENTS_LOCK), exist_ok=True)
    fd = lock_lib._open_lock(EVENTS_LOCK)
    acquired = False
    deadline = time.time() + timeout
    try:
        while True:
            if lock_lib._acquire(fd):
                acquired = True
                break
            if time.time() >= deadline:
                print("⚠ 事件锁等待超时（%.0fs），降级放行（可能偶发 seq 竞争）" % timeout,
                      file=sys.stderr)
                break
            time.sleep(0.05)
        _events_lock_held = True
        try:
            yield
        finally:
            _events_lock_held = False
    finally:
        if acquired:
            lock_lib._release(fd)
        os.close(fd)


def append_event(ev, task_id, from_status=None, to_status=None, reason=None, dispatch_ref=None):

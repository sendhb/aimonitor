def cmd_new(args):
    if not args:
        die("用法: task new \"描述\" [--slug x] [--priority P1] [--risk P2] [--approval-ref none] [--assignee any] [--reviewer any] [--parent TASK-000]")
    desc = args[0]
    opts = {}
    i = 1
    while i < len(args):
        if args[i].startswith("--") and i + 1 < len(args):
            opts[args[i]] = args[i + 1]
            i += 2
        else:
            i += 1
    slug = opts.get("--slug", "")
    if not slug:
        slug = re.sub(r"[^a-z0-9]+", "-", desc.lower()).strip("-")
        if not slug:
            slug = "task"
    # TASK-099：编号分配→写任务文件→事件追加全程持跨进程锁，
    # 消除并发 task new 的撞号/重 seq（2026-09-04 双 174 实录）。
    with _events_lock():
        nums = [int(TASK_RE.match(f).group(1)) for f in task_files() if TASK_RE.match(f)]
        num = (max(nums) + 1) if nums else 1
        task_id = f"TASK-{num:03d}"
        name = f"{task_id}-{slug}"
        path = os.path.join(TASKS_DIR, name + ".md")
        if os.path.exists(path):
            die(f"已存在: {path}")
        template = ""
        if os.path.exists(TEMPLATE):  # TASK-089：with 关闭，消 ResourceWarning/fd 泄漏
            with open(TEMPLATE, encoding="utf-8") as f:
                template = f.read()
        if not template:
            die("模板缺失: runtime/tasks/TASK.template.md")
        now = today()
        body = (template
                .replace("TASK-000-<slug>", name)
                .replace("一句话说明任务目标", desc)
                .replace("  status: open", f"  status: open")
                .replace("  created: YYYY-MM-DD", f"  created: {now}")
                .replace("  updated: YYYY-MM-DD", f"  updated: {now}")
                .replace("  priority: P2", f"  priority: {opts.get('--priority', 'P2')}")
                .replace("  risk: P2", f"  risk: {opts.get('--risk', 'P2')}")
                .replace("  approval-ref: none", f"  approval-ref: {opts.get('--approval-ref', 'none')}")
                .replace("  assignee: any", f"  assignee: {opts.get('--assignee', 'any')}")
                .replace("  reviewer: any", f"  reviewer: {opts.get('--reviewer', 'any')}"))
        if opts.get("--parent"):
            body = body.replace("  parent: TASK-000", f"  parent: {opts['--parent']}")
        body = body.replace("TASK-000 — 任务标题", f"{task_id} — {desc}")
        with open(path, "w", encoding="utf-8") as f:
            f.write(body)
    print(f"✓ 已创建 {name}.md")
    print(f"  编辑: {path}")
    print(f"  开始: task start {task_id}")
    append_event("task.created", name, to_status="open")


